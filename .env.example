DATABASE_URL="postgresql://postgres:postgres@localhost:5432/admission_atlas?schema=public"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_SECRET_KEY
CLERK_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# File storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=YOUR_BLOB_TOKEN

# Rate limiting (Upstash Redis — falls back to in-memory if not set)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI analysis (returns mock response if not set)
OPENAI_API_KEY=""

# Sentry error monitoring (leave empty to disable)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
